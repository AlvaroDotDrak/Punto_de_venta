"""Plantilla de backend/mail_secrets.py — copiar a mail_secrets.py y completar
con la cuenta emisora real. Ese archivo nunca va al repo (.gitignore).

Generar la contraseña de aplicación en la cuenta Google: Seguridad →
Verificación en 2 pasos → Contraseñas de aplicaciones. Usar una cuenta
dedicada, no la personal — ver backend/mail_defaults.py."""
import base64

HOST = "smtp.gmail.com"
PORT = 587
USER = "casilla-dedicada@gmail.com"
PASSWORD_B64 = base64.b64encode(b"contraseña-de-aplicacion-de-16-caracteres").decode()


def password() -> str:
    return base64.b64decode(PASSWORD_B64).decode()
